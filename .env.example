# Copy to .env and fill in. Never commit the real .env.

# One of these is required for live runs (scripts/run_live.py).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Which provider/model to use for live runs.
# The submitted live runs used: LLM_PROVIDER=gemini LLM_MODEL=gemini-3.1-flash-lite
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite

# Database. Defaults to a local SQLite file if unset (see app/db.py).
# For Postgres: postgresql+psycopg2://user:password@localhost:5432/kasparro
DATABASE_URL=sqlite:///./kasparro.db

# Langfuse (traces are skipped if these are unset).
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
