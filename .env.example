# Copy to .env and fill in. Never commit the real .env.

# One of these is required for live runs (scripts/run_live.py).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Which provider/model to use for live runs.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Database. Defaults to a local SQLite file if unset (see app/db.py).
# For Postgres: postgresql+psycopg2://user:password@localhost:5432/kasparro
DATABASE_URL=sqlite:///./kasparro.db

# Langfuse (optional but required for the observability rubric item).
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
